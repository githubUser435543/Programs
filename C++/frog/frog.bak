#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;


vector<int> getListOfInts(int numInts){ // works
	vector<int> intlist = {};
	for (int i = 0; i < numInts; i++){
		int tmp = 0;
		cin >> tmp;
		intlist.push_back(tmp);
	}
	return intlist;
}

int calcHurt(int rock1, int rock2){ // works
	return abs(rock1 - rock2);
}

unordered_map<string, int> dp = {};
vector<int> hurtTotals = {};
void solution(vector<int> arr, long long int index, long long int hurt){ // when called hurt should be 0
	string resultKey = "";
	long long int resultVal = 0;
	long long int size = arr.size();
	if (index >= size-1){
		hurtTotals.push_back(hurt);
		return;
	} else if (index == size-2){
		resultKey = to_string(arr[index]) + " " + to_string(arr[index+1]);
		if (dp.find(resultKey) == dp.end()){
			resultVal = calcHurt(arr[index], arr[index+1]); //calc val
			dp.insert({resultKey, resultVal}); // save to map
			solution(arr, index+1, hurt + resultVal);
		} else {
			resultVal = dp[resultKey];
			solution(arr, index+1, hurt + resultVal);
		}

	} else {
		for (int i = 1; i < 3; i++){			
			resultKey = to_string(arr[index]) + " " + to_string(arr[index+i]);
			if (dp.find(resultKey) == dp.end()){
				resultVal = calcHurt(arr[index], arr[index+i]); //calc val
				dp.insert({resultKey, resultVal}); // save to map
				solution(arr, index+i, hurt + resultVal);
			} else {
				resultVal = dp[resultKey];
				solution(arr, index+i, hurt + resultVal);
			}
		}
	}
}

int main(){
	//cout << __cplusplus << endl;
	int rocks = 0;
	cin >> rocks;
	vector<int> rockHights = getListOfInts(rocks);
	solution(rockHights, 0, 0);
	int lowest = hurtTotals[0];
	for (int item : hurtTotals){
		if (item < lowest){
			lowest = item;
		}
	}
	cout << lowest << endl;
	unordered_map<string, int> dp = {};
	vector<int> hurtTotals = {};
	return 0;
}